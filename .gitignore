# Saídas geradas pelos scripts (mantém apenas o .gitkeep)
output/*.json
output/*.md
!output/.gitkeep

# Idem para o índice vetorial e respostas do lab de RAG
rag-java-especialista/output/*.json
rag-java-especialista/output/*.md
