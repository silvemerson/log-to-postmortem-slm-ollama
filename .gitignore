# Saídas geradas pelos scripts (mantém apenas o .gitkeep)
output/*.json
output/*.md
!output/.gitkeep

# Idem para o índice vetorial e respostas do lab de RAG
rag-java-especialista/output/*.json
rag-java-especialista/output/*.md
!rag-java-especialista/output/.gitkeep

# Cache de bytecode do Python
__pycache__/
*.pyc

# Prints usados nos slides da palestra (ficam só localmente)
img/

# Exports do deck Marp (binários regeneráveis — ver slides/README.md)
slides/*.pdf
slides/*.html

# Assets soltos na raiz usados como fonte pros slides (as cópias tratadas
# ficam versionadas em slides/assets/)
/logo-dockerday.png
/Docker.png

# Variáveis de ambiente reais (use .env.example como base)
.env

# Volumes/dados locais, caso alguém use bind mounts em vez de named volumes
ollama_models/
open_webui_data/
